<!DOCTYPE html>
<html lang="nl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>IndividueelProfielPagina</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>
    <%- include('partials/header') %>
    <main>
        <section class="profile-header">
    <div class="pfpContainer">
        <img src="<%= theUser.image || '/images/profilePlaceholder.png' %>" id="userPfp" alt="profielfoto">
        
        <input type="file" id="change-pfp-input" style="display: none;">
        <label for="change-pfp-input" class="edit-photo-label">Foto aanpassen</label>
    </div>

    <div class="profile-info-box">
        <%- include('partials/editMode') %>
        
        <ul class="profile-content">
            <li><h1 id="userName"><%= theUser.name %></h1></li>
            <li><h2 id="rol"><%= theUser.role %></h2></li>
        </ul>
        
        <ul class="important-qualities" id="importantQualities">
            <li><h4><%= theUser.experience %> jaar werkervaring</h4></li>
            <li><h4>Amsterdam</h4></li>
        </ul>
        
        <p id="bio"><%= theUser.bio %></p>
        
        <ul class="qualities" id="idQualities">
            <% if (theUser.skills && theUser.skills.length > 0) { %>
                <% theUser.skills.forEach(skill => { %>
                    <li><%= skill %></li>
                <% }); %>
            <% } %>
            <button type="button" class="add-quality-btn" onclick="addProfileQuality()">+ Kwaliteit toevoegen</button>
        </ul>
    </div>
</section>

        <ul class="project-grid">
    <% if (typeof projects !== 'undefined' && projects.length > 0) { %>
        <% projects.forEach(project => { %>
            <li class="project-card">
                <button class="project-link" 
    data-id="<%= project._id %>"
    data-title="<%= project.title %>"
    data-type="<%= project.type %>"
    data-director="<%= project.director || '' %>"
    data-contribution="<%= project.description %>"
    data-genres="<%= (project.genres || [project.role || project.type]).join(',') %>"
    data-all-images="<%= (project.images) ? project.images.join(',') : '' %>>"
    data-image="<%= project.mainImage || '/images/projectPlaceholder.png' %>">
    
    
    <div class="image-placeholder">
        <img src="<%= project.mainImage || '/images/projectPlaceholder.png' %>" alt="project foto">
    </div>
    <div class="project-info">
        <h3><%= project.title %></h3>
        <h4><%= project.type %></h4>
    </div>
</button>
            </li>
        <% }); %>
    <% } %>
    <%- include('partials/addProjectCard') %>
</ul>
        </section>
    </main>

    <div id="project-modal" class="modal">
        <div class="modal-content">
            <span class="close-modal">&times;</span>
            <div id="modal-body"></div>
        </div>
    </div>

    <%- include('partials/footer') %>

    <script src="/js/addProjectCard.js"></script>
    <script src="/js/editMode.js"></script>

    <script>
       const modal = document.getElementById("project-modal");
const modalBody = document.getElementById("modal-body");
const closeBtn = document.querySelector("#project-modal .close-modal");

function openModal(projectId) {
    const btn = document.querySelector(`[data-id="${projectId}"]`);
    const isEditing = document.body.classList.contains('is-editing');
    
    const details = {
        title: btn.getAttribute('data-title'),
        type: btn.getAttribute('data-type'),
        director: btn.getAttribute('data-director'),
        contribution: btn.getAttribute('data-contribution'),
        mainImage: btn.getAttribute('data-image'),
        allImages: btn.getAttribute('data-all-images').split(',').filter(i => i !== ""),
        genres: btn.getAttribute('data-genres').split(',').filter(g => g !== "")
    };

    if (isEditing) {
        // ... (hou je huidige edit-code, maar voeg eventueel director-veld toe)
    } else {
        const tagList = details.genres.map(g => `<li>${g}</li>`).join('');
        
        // Maak HTML voor extra afbeeldingen
        const extraImagesHTML = details.allImages.slice(1).map(img => 
            `<img src="${img}" style="width: 30%; aspect-ratio: 16/9; object-fit: cover; border-radius: 5px;">`
        ).join('');

        modalBody.innerHTML = `
            <img src="${details.mainImage}" class="modal-image">
            <h2>${details.title}</h2>
            <p style="margin-top: -10px; color: gray;">${details.type} ${details.director ? ' | Director: ' + details.director : ''}</p>
            <ul class="qualities">${tagList}</ul>
            <p>${details.contribution}</p>
            
            ${details.allImages.length > 1 ? `
                <div style="margin-top: 20px;">
                    <h4>Meer beelden</h4>
                    <div style="display: flex; gap: 10px; flex-wrap: wrap;">${extraImagesHTML}</div>
                </div>
            ` : ''}
        `;
    }
    modal.style.display = "block";
}

// Hulpmiddelen voor de modal
function addTagToProjectModal() {
    const val = prompt("Welke nieuwe tag?");
    if (val) {
        const li = document.createElement('li');
        li.innerHTML = `${val} <span class="delete-tag" onclick="this.parentElement.remove()">×</span>`;
        const list = document.getElementById('edit-project-tags');
        list.insertBefore(li, list.querySelector('.add-quality-btn'));
    }
}

async function saveProjectChanges(projectId) {
    const formData = new FormData();
    formData.append('projectId', projectId);
    formData.append('title', document.getElementById('edit-title').value);
    formData.append('type', document.getElementById('edit-type').value);
    formData.append('contribution', document.getElementById('edit-contribution').value);
    
    // Tags verzamelen
    const tagElements = document.querySelectorAll('#edit-project-tags li');
    const tags = Array.from(tagElements).map(li => li.innerText.replace('×', '').trim());
    formData.append('genres', JSON.stringify(tags));

    // Foto toevoegen als die is aangepast
    const fileInput = document.getElementById('edit-project-file-input');
    if (fileInput && fileInput.files[0]) {
        formData.append('projectImage', fileInput.files[0]);
    }

    const response = await fetch('/update-project-details', {
        method: 'POST',
        body: formData // Geen JSON.stringify en geen Headers!
    });

    if (response.ok) {
        location.reload();
    } else {
        alert("Fout bij opslaan");
    }
}

// Klik-events
document.addEventListener('click', (e) => {
    const btn = e.target.closest('.project-link');
    if (btn) openModal(btn.getAttribute('data-id'));
});

function closeModal() { modal.style.display = "none"; }
closeBtn.onclick = closeModal;

// Foto preview profielfoto
document.getElementById('change-pfp-input').addEventListener('change', (e) => {
    const file = e.target.files[0];
    if (file) { document.getElementById('userPfp').src = URL.createObjectURL(file); }
});

function addProfileQuality() {
    const val = prompt("Nieuwe kwaliteit?");
    if (val) {
        const li = document.createElement('li');
        li.innerHTML = `${val}<span class="delete-tag" onclick="this.parentElement.remove()">×</span>`;
        document.getElementById('idQualities').appendChild(li);
    }
}

async function deleteProject(projectId) {
    if (confirm("Weet je zeker dat je dit project wilt verwijderen?")) {
        const response = await fetch('/delete-project', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ projectId: projectId })
        });

        if (response.ok) {
            location.reload();
        } else {
            alert("Verwijderen mislukt.");
        }
    }
}
    </script>
</body>
</html>