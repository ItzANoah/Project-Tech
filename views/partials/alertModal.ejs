<div id="customAlertModal" class="modal" style="z-index: 2000;">
    <div class="modal-content" style="max-width: 400px; text-align: center; border-radius: 25px; padding: 2rem;">
        <button type="button" class="close-modal" onclick="closeCustomAlert()" style="position: absolute; top: 0.5em; right: 0.7em; background: none; border: none; font-size: var(--h2Size, 2em); font-weight: var(--fontWeightBold); cursor: pointer; color: var(--accentColorRed); transition: color 0.2s;">&times;</button>
        
        <h3 id="customAlertMessage" style="margin: 1.5rem 0; font-family: var(--montserratFont); color: var(--accentColorRed); font-size: 1.2em;">Bericht</h3>
        
        <button type="button" onclick="closeCustomAlert()" style="margin: 1rem auto 0 auto; display: block; background-color: var(--accentColorRed); color: white; border: none; border-radius: 25px; padding: 0.8rem 2.5rem; font-family: var(--montserratFont); font-weight: bold; cursor: pointer; transition: background-color 0.3s ease;">OK</button>
    </div>
</div>