<!-- eigen pop-up gemaakt roept close aan zodra je op de knop klikt.-->
<div id="customAlertModal" class="modal">
    <div class="modal-content custom-alert-content">
        <button type="button" class="close-modal" onclick="closeCustomAlert()">&times;</button>
        
        <h3 id="customAlertMessage">Bericht</h3>
        
        <button type="button" class="custom-alert-btn" onclick="closeCustomAlert()">OK</button>
    </div>
</div>