<!-- plus kaartje project toevoegen carousel -->
 <!-- edit only zodat de normale bezoeker de kaart niet ziet-->
<li class="carousel__list-Item edit-only">
    <!-- styling van de matching__card en onclick op de hele kaart-->
    <div class="matching__card add-project-card" onclick="openAddProjectModal()">
        
        <div class="add-project-card__image-container">
            <span class="add-project-card__plus">+</span>
        </div>

        <div class="matching__card-content">
            <h3 class="matching__card-title">Project toevoegen</h3>
            <p class="matching__card-text">Voeg een film toe aan je carrousel.</p>
        </div>

        <div class="matching__card-link">
            Selecteer
        </div>
    </div>
</li>