<!--Matching-card-->

<article class="matching__card">
    <header>
        <img src="<%= item.image || item.images?.[0] || '/images/image-not-found.png' %>" width="335" alt="<%= item.name %>">
        <h3 class="matching__card-body"><%= item.name%> - <%= item.role%> <%= item.type %></h3>
    </header>
    <p class="matching__card-body"><%= item.bio %></p>
    <div class=" matching__card-link">
        <a href="/profile/<%= item._id %>">Bekijk details</a>
    </div>
</article>