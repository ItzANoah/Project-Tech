<!--Matching-card-->

<article class="matching-card">
    <header>
        <img src="<%= item.image || item.images?.[0] || '/images/image-not-found.png' %>" width="335" alt="<%= item.name %>">
        <h3 class="matching-card__body"><%= item.name %> - <%= item.type || item.role %></h3>
    </header>
    <div class="matching-card__body-wrapper">
        <p class="matching-card__body"><%= item.bio %></p>
    </div>
    <div class="matching-card__link">
        <a href="<%= item.type ? '/crew-profile?id=' + item._id : '/profiel/' + item._id %>">Bekijk details</a>
    </div>
</article>