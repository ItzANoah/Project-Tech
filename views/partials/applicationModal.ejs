<!-- solliciatie aanmaken edit modus pop-up-->
<div id="applicationModal" class="modal">
    <div class="modal__content">
        <div class="modal__header">
            <h3>Nieuwe Sollicitatie Aanmaken</h3>
            <button type="button" class="close-modal" onclick="closeApplicationModal()">&times;</button>
        </div>
        
        <div class="modal__body"> 
            <div class="form-group">
                <input type="text" id="appTitle" placeholder="Functie Titel" required>
            </div>
            
            <div class="form-group">
                <textarea id="appDesc" placeholder="Jouw beschrijving..."></textarea>
            </div>
            
            <button type="button" class="btn-save" onclick="saveNewApplication()">Toevoegen</button>
        </div>
    </div>
</div>