<!-- crew-profile pagina is opgebouwd uit zoveel mogelijk partials om overzicht te behouden-->
<%- include('partials/head') %> 
<%- include('partials/header') %> 

<!-- Hele document zit in een form gewrapt zodat ik met 1 knop alles kan versturen -->
 <!-- hier gebruik ik multipart/form-data om aan te geven dat we niet alleen tekst maar ook foto's willen sturen -->
<form id="projectForm" action="/save-project" method="POST" enctype="multipart/form-data">
    <!-- achtergrond kleur van de bovenkant --> 
    <div class="background--wrapper">
    
    <main class="project--container">
        
        <%- include('partials/crewProfile-Header') %> 
        <%- include('partials/slideshow') %> 
        <%- include('partials/filters') %>
        <%- include('partials/crewProfile-projectDescription') %> 
        
    </main>
    </div>

    <%- include('partials/crewProfile-productionDescription') %> 
    <%- include('partials/crewProfile-projectenCarousel') %>
    
    <!--links data binnen applicationsection.ejs en rechts data die uit de server.js word mee gegeven
    uit de database zo krijgt hij gelijk een lijst mee-->
    <%- include('partials/applicationSection', { applications: applications }) %>
    
    <!-- onzichtbaar veld geeft in de html het huidige id mee van dit project, 
     dit is om aan te geven aan welk project sollicitaties en projecten moeten toegevoegd worden. -->
    <input type="hidden" id="currentProjectId" value="<%= projectData._id %>">
</form>

   <!-- alle modals staan buiten de vorm deze hoeven niet mee gestuurd te worden
    en hebben zo geen last van z index problemen -->
<%- include('partials/applicationModal') %>
<%- include('partials/modalSolliciteren') %>
<%- include('partials/addProjectModal') %> 
<%- include('partials/alertModal') %>

<script src="js/slideshow.js"></script>
<script src="js/filters.js"></script>
<script src="js/editmode-button.js"></script>
<script src="js/tekstcounter.js"></script>
<script src="/js/carousel-edit.js"></script>
<script src="/js/applicationSection.js"></script>
<script src="/js/ModalSolliciteren.js"></script>
<script src="/js/alertModal.js"></script>
<script src="/js/successAlert.js"></script>

<%- include('partials/footer') %> 
</body>

</html>