<!DOCTYPE html>
<html lang="nl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FilmCrew</title>
    <link rel="stylesheet" href="css/style.css">
</head>


<body>
    <%- include('partials/header') %>
    <main>
        <header class="hero">
            <div class="hero__container">
                <hgroup>
                    <h1 class="hero__heading">Zoek talent. Of wordt <br>gevonden.</h1>
                    <p>Start een project. Sluit je aan.</p>
                </hgroup>

                <a href="/matching">Ontdek meer!</a>
            </div>

            <img
                class="hero__image"
                src="/images/home-page-image.png"
                alt="Filmset met camera’s, verlichting en crewleden tijdens een productie – banner voor platform om filmprojecten en talent te vinden."
            >
        </header>

        <section class="all-projects">
            <h2>Alle projecten</h2>
            <%- include('partials/matching-slider', { profiles }) %>
        </section>
    </main>
    <%- include('partials/footer') %>
</body>
</html>