<!DOCTYPE html>
<html lang="nl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FilmCrew - Huidige Matches</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="icon" type="image/x-icon" href="/images/favicon.ico">
</head>

<body>
    <%- include('partials/header') %>

<main>
    <div class="current__new-match">
        <div class="current__active-notification">
            <h2 class="current__h2">Nieuwste Matches</h2>
            <% if (locals.globalNotification) { %>
                <div class="current__notification">!</div>
            <% } %>
        </div>
        
        <div class="matches__filter-dropdown">
            <label class="matches__filter__label" for="sort-new">Sorteren op:</label>
            <select id="sort-new">
                <option value="most-recent">Meest recent</option>
                <option value="best-match">Beste match</option>
            </select>
        </div>

        <ul class="carousel__list">
            <% if (aanvragen && aanvragen.length > 0) { %>
              <% aanvragen.forEach(item => { %>
                <li class="carousel__list-Item">
                  <%- include('partials/matching-request', { match: item }) %>
                </li>
              <% }) %>
            <% } else { %>
              <p>Je hebt momenteel geen nieuwe aanvragen.</p>
            <% } %>
        </ul>
    </div>

    <div class="current__matches">
            <h2 class="current__h2">Je huidige matches</h2>
        
        <ul class="matching__carousel">
            <% if (matches && matches.length > 0) { %>
                <% matches.forEach(match => { %>
                    <%- include('partials/matching-current', { match: match }) %>
                <% }); %>
            <% } else { %>
                <p>Je hebt op dit moment geen actieve matches.</p>
            <% } %>
            </ul>
    </div>
</main>

<%- include('partials/footer') %>
<script src="/js/matches.js"></script>
</body>
</html>